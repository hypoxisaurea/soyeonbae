---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";
import LanguageToggle from "../components/LanguageToggle.astro";
import { ViewTransitions } from "astro:transitions";

import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from "../config";

const {
  image,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  includeSidebar = true,
  sideBarActiveItemID,
  ogType,
  locale = "ko",
  showLanguageToggle = true,
} = Astro.props;

const pathname = Astro.url.pathname;
const koreanPath = locale === "ko" ? pathname : pathname.replace(/^\/en(?=\/|$)/, "") || "/";
const englishPath = locale === "en" ? pathname : pathname === "/" ? "/en/" : `/en${pathname}`;
---

<!doctype html>
<html lang={locale} data-theme="lofi">
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} />
    <link rel="alternate" hreflang="ko" href={new URL(koreanPath, Astro.url)} />
    <link rel="alternate" hreflang="en" href={new URL(englishPath, Astro.url)} />
    <link rel="alternate" hreflang="x-default" href={new URL(koreanPath, Astro.url)} />
    {TRANSITION_API && <ViewTransitions />}
  </head>
  <body>
    <div class:list={["bg-base-100", includeSidebar && ["drawer", "lg:drawer-open"]]}>
      {includeSidebar && <input id="my-drawer" type="checkbox" class="drawer-toggle" />}
      <div class="drawer-content bg-base-100">
        {includeSidebar && <Header title={SITE_TITLE} />}
        <div class="md:flex md:justify-center">
          <main class="p-6 pt-10 lg:max-w-[900px] max-w-[100vw]">
            {showLanguageToggle && <LanguageToggle locale={locale} />}
            <slot />
          </main>
        </div>
        <Footer />
      </div>
      {includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} />}
    </div>
  </body>
</html>
