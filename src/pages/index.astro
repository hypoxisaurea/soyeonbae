---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfileDetails from "../components/ProfileDetails.astro";
import AdaptiveProfile from "../components/AdaptiveProfile.astro";
import { projectCases } from "../data/projectCases";

const publications = [
  {
    title: "도메인 특화 임베딩 학습을 활용한 한국어 법률 질의응답 RAG 시스템 최적화 연구",
    venue: "KCSE 2026",
    role: "제1저자",
    description: "법률 도메인 임베딩 fine-tuning과 검색 평가 체계를 통해 MRR@10을 최대 5.6% 개선했습니다.",
  },
  {
    title: "약관조항에 대한 초거대언어 모델의 공정성판단 연구",
    venue: "KCC 2025",
    role: "제2저자 (2/5)",
    description: "LLM을 활용한 약관 조항 공정성 판단의 가능성과 한계를 분석했습니다.",
  },
];

const experience = [
  { title: "SSAFY 16기", role: "Samsung Software Academy", period: "2026.07 — Present", bullets: ["AI 서비스와 금융 도메인 프로젝트를 개발하며 소프트웨어 역량을 확장하고 있습니다."] },
  { title: "DeepModal", role: "AI Researcher", period: "2025.06 — 2025.12", bullets: ["공정거래위원회 AI 약관 심사 플랫폼의 법령 데이터 구축과 RAG 검색 성능 개선을 담당했습니다.", "89,994쌍의 QA 데이터를 구축하고 국내 학술대회 논문 2편을 게재했습니다."] },
  { title: "Prometheus 5기", role: "AI Project Member", period: "2024.03 — 2025.02", bullets: ["암호화폐 백서 분석, LLM 기반 추리 게임, 맞춤형 동화 생성 프로젝트를 수행했습니다."] },
  { title: "UMC 5기", role: "Frontend Study Lead", period: "2023.09 — 2024.02", bullets: ["React 스터디를 이끌고 Career Festival 프로젝트의 주요 화면을 구현했습니다."] },
  { title: "설리번 프로젝트", role: "Development Education Volunteer", period: "2020.09 — 2021.02", bullets: ["Flutter 일기장 앱 커리큘럼과 자료를 제작하고 고등학생·비전공자 대상 교육을 진행했습니다."] },
];

const education = [
  { title: "Hansung University", detail: "B.S. in Computer Engineering", period: "2020.03 — 2025.02" },
  { title: "LG AI Aimers 4기", detail: "AI/ML 교육 수료", period: "2024.01 — 2024.02" },
  { title: "Naver Coaching Study", detail: "Data Science 과정 수료", period: "2024.01 — 2024.02" },
  { title: "SK AI Data Academy 1기", detail: "산업 데이터 기반 AI 프로젝트", period: "2024.07 — 2024.08" },
];

const awards = [
  ["대상", "2025 제주 런케이션 AI 해커톤", "Wecation"],
  ["최우수상", "2025 서울 AI 해커톤", "Kaption"],
  ["동상", "2024 공개 SW 개발자대회", "Hearus"],
  ["인기상", "2024 스마일게이트 AI 위클리톤", "Toon Surfing"],
];

const featuredProjectSlugs = ["darkaudit", "finagent-sme", "kaption", "legal-rag", "autorag-nvidia-reranker", "hearus"];
const featuredProjects = projectCases.filter((project) => featuredProjectSlugs.includes(project.slug));

const certifications = ["AWS Certified AI Practitioner", "빅데이터분석기사", "정보처리기사", "ADsP", "SQLD"];
---

<BaseLayout includeSidebar={false} title="배소연 | AI Engineer" description="RAG, Agentic AI, 멀티모달 시스템을 실제 서비스로 구현하는 AI Engineer 배소연의 포트폴리오">
  <AdaptiveProfile />
  <article class="portfolio-v2">
    <header class="v2-cover" id="top">
      <div class="v2-cover-meta"><span>PORTFOLIO · 2026</span><span>BAE SOYEON</span></div>
      <div class="v2-cover-copy">
        <p>문제를 정의하고, 근거를 설계하고,<br />끝까지 작동하게 만드는</p>
        <h1>AI<br />ENGINEER</h1>
      </div>
      <div class="v2-cover-bottom">
        <p>RAG · Agentic AI · Multimodal Systems</p>
        <a href="#projects">Selected work <span aria-hidden="true">↓</span></a>
      </div>
    </header>

    <div class="v2-layout">
      <aside class="v2-profile" aria-label="프로필과 페이지 내 이동">
        <div class="v2-profile-head"><img class="v2-profile-photo" src="/IMG_6696.JPG" alt="배소연 프로필 사진" width="190" height="238" loading="lazy" /><div><h2>배소연</h2><p>AI Engineer</p></div></div>
        <p class="v2-profile-note">복잡한 정보를 근거가 분명하고 실제로 사용할 수 있는 AI로 만듭니다.</p>
        <div class="v2-profile-facts"><p><span>BASE</span>Seoul, South Korea</p><p><span>NOW</span>SSAFY 16기</p><p><span>EDU</span>Hansung University</p></div>
        <nav class="v2-index" aria-label="페이지 내 이동">
          <a href="#about"><span>01</span>About</a><a href="#projects"><span>02</span>Projects</a><a href="#research"><span>03</span>Research</a><a href="#experience"><span>04</span>Experience</a><a href="#credentials"><span>05</span>Credentials</a><a href="#community"><span>06</span>Community</a>
        </nav>
        <div class="v2-social"><a href="mailto:flickerlight14@naver.com">Email ↗</a><a href="https://github.com/hypoxisaurea" target="_blank" rel="noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/soyeon-bae-55abb82b5" target="_blank" rel="noreferrer">LinkedIn ↗</a><a href="https://the14voyager.tistory.com" target="_blank" rel="noreferrer">Blog ↗</a></div>
      </aside>

      <div class="v2-content">
        <section id="about" class="v2-section v2-about">
          <div class="v2-section-label"><span>01</span><p>ABOUT</p></div>
          <div class="v2-section-body">
            <p class="v2-lead">데이터에서 인터페이스까지,<br /><strong>검증 가능한 AI 서비스</strong>를 설계합니다.</p>
            <p class="v2-body-copy">법률·금융처럼 신뢰가 중요한 도메인에서 데이터 구축, 검색 평가, 모델 연동, 사용자 인터페이스를 하나의 서비스 흐름으로 연결해 왔습니다. 높은 성능 수치에 머무르지 않고 실패 원인을 설명하고 다시 검증할 수 있는 시스템을 지향합니다.</p>
            <dl class="v2-metrics"><div><dt>89,994</dt><dd>법률 QA 데이터 구축</dd></div><div><dt>+5.6%</dt><dd>MRR@10 개선</dd></div><div><dt>2</dt><dd>국내 학술대회 논문</dd></div><div><dt>4</dt><dd>프로젝트 수상</dd></div></dl>
          </div>
        </section>

        <section id="projects" class="v2-section">
          <div class="v2-section-label"><span>02</span><p>SELECTED PROJECTS</p></div>
          <div class="v2-section-body">
            <div class="v2-heading-row"><h2>Selected Projects</h2><a href="/projects/">전체 프로젝트 보기 ↗</a></div>
            <div class="v2-projects">
              {featuredProjects.map((project, index) => (
                <article class="v2-project">
                  <a class="v2-project-main" href={`/projects/${project.slug}/`} aria-label={`${project.title} 케이스 스터디`}>
                    <div class="v2-project-top"><span>{String(index + 1).padStart(2, "0")}</span><time>{project.period}</time></div>
                    <p>{project.kicker}</p><h3>{project.title}</h3><p class="v2-project-summary">{project.summary}</p>
                    <p class="v2-project-result">{project.results[0]}</p>
                    <ul class="v2-project-stack" aria-label="주요 기술">{project.stack.slice(0, 4).map((technology) => <li>{technology}</li>)}</ul>
                    <div class="v2-project-foot"><span>{project.role}</span><span>Case study →</span></div>
                  </a>
                  {(project.github || project.demo) && <div class="v2-project-resources">{project.github && <a href={project.github} target="_blank" rel="noreferrer">GitHub ↗</a>}{project.demo && <a href={project.demo} target="_blank" rel="noreferrer">Demo ↗</a>}</div>}
                </article>
              ))}
            </div>
          </div>
        </section>

        <section id="research" class="v2-section">
          <div class="v2-section-label"><span>03</span><p>RESEARCH</p></div>
          <div class="v2-section-body"><h2 class="v2-display-heading">Publications</h2><div class="v2-rows">{publications.map((item) => <article><div><span class="v2-tag">{item.venue}</span><span class="v2-role">{item.role}</span></div><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></div>
        </section>

        <section id="experience" class="v2-section">
          <div class="v2-section-label"><span>04</span><p>EXPERIENCE</p></div>
          <div class="v2-section-body"><h2 class="v2-display-heading">Experience</h2><div class="v2-timeline">{experience.map((item) => <article><time>{item.period}</time><div><h3>{item.title}</h3><p class="v2-role">{item.role}</p>{item.bullets.map((bullet) => <p>{bullet}</p>)}</div></article>)}</div></div>
        </section>

        <section id="credentials" class="v2-section">
          <div class="v2-section-label"><span>05</span><p>CREDENTIALS</p></div>
          <div class="v2-section-body">
            <div class="v2-credential-grid">
              <div><h2>Education</h2>{education.map((item) => <article><time>{item.period}</time><h3>{item.title}</h3><p>{item.detail}</p></article>)}</div>
              <div><h2>Awards</h2>{awards.map(([award, event, project]) => <article><span class="v2-tag">{award}</span><h3>{event}</h3><p>{project}</p></article>)}</div>
            </div>
            <div class="v2-skills"><h2>Skills &amp; Certifications</h2><p><strong>AI / DATA</strong>Python, SQL, PyTorch, TensorFlow, Pandas, RAG, LangChain, RAGAS</p><p><strong>PRODUCT</strong>TypeScript, React, Java, FastAPI, REST API, Chrome Extension</p><p><strong>CLOUD / TOOLS</strong>AWS, Git, GitHub, Firebase, Selenium, Figma</p><p><strong>CREDENTIALS</strong>{certifications.join(" · ")}</p><p><strong>LANGUAGE</strong>TOEIC 915 · TOEIC Speaking Advanced Low</p></div>
          </div>
        </section>

        <section class="v2-section" id="community"><div class="v2-section-label"><span>06</span><p>COMMUNITY & OPEN SOURCE</p></div><div class="v2-section-body"><ProfileDetails locale="ko" /></div></section>

        <footer class="v2-contact"><p>함께 풀고 싶은 문제가 있다면</p><h2>Let's build<br /><em>trustworthy AI.</em></h2><div><a href="mailto:flickerlight14@naver.com">flickerlight14@naver.com ↗</a><a href="/cv/">이력서 보기 ↗</a><a href="#top">Back to top ↑</a></div></footer>
      </div>
    </div>
  </article>
</BaseLayout>
