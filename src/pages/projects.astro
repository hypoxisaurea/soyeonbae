---
import ProjectResources from "../components/ProjectResources.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projectCases } from "../data/projectCases";

const repositories = [
  ["북적북적", "대학교재 중고거래 Android 앱", "https://github.com/hypoxisaurea/book_crowded"],
  ["Career Festival", "오프라인 행사 매칭 및 기록 웹 서비스", "https://github.com/hypoxisaurea/Career_Festival_Front"],
  ["Suzip", "감정 분석 기반 콘텐츠 추천 일기 서비스", "https://github.com/hypoxisaurea/SUZIP-Frontend"],
  ["Toon Surfing", "AI 기반 웹툰 장면 검색 서비스", "https://github.com/hypoxisaurea/toonsurfing_frontend"],
];
---
<BaseLayout includeSidebar={false} title="Projects | 배소연" description="배소연의 RAG, 멀티 에이전트, 멀티모달 AI 프로젝트와 상세 기여 내용" sideBarActiveItemID="projects">
  <div class="standalone-page">
    <p class="eyebrow">PROJECTS</p>
    <h1>문제를 정의하고,<br />서비스로 풀어낸 과정.</h1>
    <p class="page-lead">무엇을 해결하려 했고, 어떤 기술로 구현했는지 정리했습니다. 각 프로젝트에서 맡은 역할과 판단의 이유, 결과와 배운 점을 살펴볼 수 있습니다.</p>
    <div class="standalone-list">
      {projectCases.map((project) => (
        <article>
          <p class="entry-category">{project.kicker}</p>
          <h2><a href={`/projects/${project.slug}/`}>{project.title} →</a></h2>
          <p>{project.summary}</p>
          <dl class="project-overview">
            <div><dt>문제 정의</dt><dd>{project.problem}</dd></div>
            <div><dt>{project.contributionScope === "project" ? "프로젝트 분야" : "담당 역할"}</dt><dd>{project.role}</dd></div>
            <div><dt>기술스택</dt><dd>{project.stack.join(" · ")}</dd></div>
          </dl>
          <div class="project-links">
            <a href={`/projects/${project.slug}/`}>{project.contributionScope === "project" ? "구현과 설계 살펴보기" : "기여와 배운 점 보기"} →</a>
            <ProjectResources project={project} class="project-resource-links" />
          </div>
        </article>
      ))}
    </div>
    <h2 class="subpage-heading">Earlier public repositories</h2>
    <div class="compact-project-grid">
      {repositories.map(([title, description, url]) => <a href={url} target="_blank" rel="noreferrer"><span>PUBLIC REPOSITORY</span><h3>{title} ↗</h3><p>{description}</p></a>)}
    </div>
    <a class="back-link" href="/#projects">홈으로 돌아가기 →</a>
  </div>
</BaseLayout>
