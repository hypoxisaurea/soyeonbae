---
import ProjectResources from "../../components/ProjectResources.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProfileDetails from "../../components/ProfileDetails.astro";
import AdaptiveProfile from "../../components/AdaptiveProfile.astro";
import { projectCasesEn } from "../../data/projectCasesEn";

const publications = [
  { title: "Optimizing a Korean Legal QA RAG System through Domain-Specific Embedding Training", venue: "KCSE 2026", role: "First Author", description: "Improved MRR@10 by up to 5.6% through legal-domain embedding fine-tuning and a reproducible retrieval evaluation framework." },
  { title: "A Study on Fairness Judgment of Contract Terms Using Large Language Models", venue: "KCC 2025", role: "Second Author (2/5)", description: "Analyzed the potential and limitations of using LLMs to assess the fairness of contract clauses." },
];

const experience = [
  { title: "SSAFY Cohort 16", role: "Samsung Software Academy", period: "2026.07 — Present", bullets: ["Developing AI services and financial-domain projects while strengthening software engineering skills."] },
  { title: "DeepModal", role: "AI Researcher", period: "2025.06 — 2025.12", bullets: ["Built legal data and improved RAG retrieval for the Korea Fair Trade Commission's AI contract-review platform.", "Created 89,994 QA pairs and published two domestic conference papers."] },
  { title: "Prometheus Cohort 5", role: "AI Project Member", period: "2024.03 — 2025.02", bullets: ["Built projects for crypto white-paper analysis, an LLM deduction game, and personalized story generation."] },
  { title: "UMC Cohort 5", role: "Frontend Study Lead", period: "2023.09 — 2024.02", bullets: ["Led a React study group and implemented key screens for Career Festival."] },
  { title: "Sullivan Project", role: "Development Education Volunteer", period: "2020.09 — 2021.02", bullets: ["Created a Flutter diary-app curriculum and taught high-school students and non-majors."] },
];

const education = [
  { title: "Hansung University", detail: "B.S. in Computer Engineering", period: "2020.03 — 2025.02" },
  { title: "LG AI Aimers Cohort 4", detail: "AI/ML Program", period: "2024.01 — 2024.02" },
  { title: "Naver Coaching Study", detail: "Data Science Program", period: "2024.01 — 2024.02" },
  { title: "SK AI Data Academy Cohort 1", detail: "Industry Data AI Project", period: "2024.07 — 2024.08" },
];

const awards = [
  ["Grand Prize", "2025 Jeju Runcation AI Hackathon", "Wecation"],
  ["Excellence Award", "2025 Seoul AI Hackathon", "Kaption"],
  ["Bronze Prize", "2024 Open Source Software Developer Competition", "Hearus"],
  ["Popularity Award", "2024 Smilegate AI Weeklython", "Toon Surfing"],
];

const featuredProjectSlugs = ["darkaudit", "finagent-sme", "kaption", "legal-rag", "autorag-nvidia-reranker", "hearus"];
const featuredProjects = projectCasesEn.filter((project) => featuredProjectSlugs.includes(project.slug));

const certifications = ["AWS Certified AI Practitioner", "Engineer Big Data Analysis", "Engineer Information Processing", "ADsP", "SQLD"];
---

<BaseLayout locale="en" includeSidebar={false} title="Soyeon Bae | AI Engineer" description="Portfolio of Soyeon Bae, an AI engineer building production-ready RAG, agentic AI, and multimodal systems.">
  <AdaptiveProfile />
  <article class="portfolio-v2">
    <header class="v2-cover" id="top">
      <div class="v2-cover-meta"><span>PORTFOLIO · 2026</span><span>BAE SOYEON</span></div>
      <div class="v2-cover-copy"><p>Defining the problem, designing the evidence,<br />and making the system work end to end.</p><h1>AI<br />ENGINEER</h1></div>
      <div class="v2-cover-bottom"><p>RAG · Agentic AI · Multimodal Systems</p><a href="#projects">Selected work <span aria-hidden="true">↓</span></a></div>
    </header>

    <div class="v2-layout">
      <aside class="v2-profile" aria-label="Profile and page navigation">
        <div class="v2-profile-head"><img class="v2-profile-photo" src="/IMG_6696.JPG" alt="Portrait of Soyeon Bae" width="190" height="238" loading="lazy" /><div><h2>Soyeon Bae</h2><p>AI Engineer</p></div></div>
        <p class="v2-profile-note">I turn complex information into grounded, usable AI products.</p>
        <nav class="v2-index" aria-label="On this page"><a href="#about"><span>01</span>About</a><a href="#projects"><span>02</span>Projects</a><a href="#research"><span>03</span>Research</a><a href="#experience"><span>04</span>Experience</a><a href="#credentials"><span>05</span>Credentials</a><a href="#community"><span>06</span>Community</a></nav>
        <div class="v2-social"><a href="mailto:flickerlight14@naver.com">Email ↗</a><a href="https://github.com/hypoxisaurea" target="_blank" rel="noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/soyeon-bae-55abb82b5" target="_blank" rel="noreferrer">LinkedIn ↗</a><a href="https://the14voyager.tistory.com" target="_blank" rel="noreferrer">Blog ↗</a></div>
      </aside>

      <div class="v2-content">
        <section id="about" class="v2-section v2-about"><div class="v2-section-label"><span>01</span><p>ABOUT</p></div><div class="v2-section-body"><p class="v2-lead">From data to interface,<br />I build <strong>verifiable AI products.</strong></p><p class="v2-body-copy">I connect data construction, retrieval evaluation, model integration, and user interfaces into complete service flows for trust-sensitive domains such as law and finance. I focus not only on better metrics, but also on systems whose failures can be explained and tested again.</p><dl class="v2-metrics"><div><dt>89,994</dt><dd>legal QA pairs built</dd></div><div><dt>+5.6%</dt><dd>MRR@10 improvement</dd></div><div><dt>2</dt><dd>conference papers</dd></div><div><dt>4</dt><dd>project awards</dd></div></dl></div></section>

        <section id="projects" class="v2-section">
          <div class="v2-section-label"><span>02</span><p>SELECTED PROJECTS</p></div>
          <div class="v2-section-body">
            <div class="v2-heading-row"><h2>Selected Projects</h2><a href="/en/projects/">View all projects ↗</a></div>
            <div class="v2-projects">{featuredProjects.map((project, index) => (
              <article class="v2-project">
                <a class="v2-project-main" href={`/en/projects/${project.slug}/`} aria-label={`${project.title} case study`}>
                  <div class="v2-project-top"><span>{String(index + 1).padStart(2, "0")}</span><time>{project.period}</time></div>
                  <p>{project.kicker}</p><h3>{project.title}</h3><p class="v2-project-summary">{project.summary}</p>
                  <p class="v2-project-result">{project.results[0]}</p>
                  <ul class="v2-project-stack" aria-label="Key technologies">{project.stack.slice(0, 4).map((technology) => <li>{technology}</li>)}</ul>
                  <div class="v2-project-foot"><span>{project.role}</span><span>Case study →</span></div>
                </a>
                <ProjectResources project={project} class="v2-project-resources" />
              </article>
            ))}</div>
          </div>
        </section>

        <section id="research" class="v2-section"><div class="v2-section-label"><span>03</span><p>RESEARCH</p></div><div class="v2-section-body"><h2 class="v2-display-heading">Publications</h2><div class="v2-rows">{publications.map((item) => <article><div><span class="v2-tag">{item.venue}</span><span class="v2-role">{item.role}</span></div><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></div></section>

        <section id="experience" class="v2-section"><div class="v2-section-label"><span>04</span><p>EXPERIENCE</p></div><div class="v2-section-body"><h2 class="v2-display-heading">Experience</h2><div class="v2-timeline">{experience.map((item) => <article><time>{item.period}</time><div><h3>{item.title}</h3><p class="v2-role">{item.role}</p>{item.bullets.map((bullet) => <p>{bullet}</p>)}</div></article>)}</div></div></section>

        <section id="credentials" class="v2-section"><div class="v2-section-label"><span>05</span><p>CREDENTIALS</p></div><div class="v2-section-body"><div class="v2-credential-grid"><div><h2>Education</h2>{education.map((item) => <article><time>{item.period}</time><h3>{item.title}</h3><p>{item.detail}</p></article>)}</div><div><h2>Awards</h2>{awards.map(([award, event, project]) => <article><span class="v2-tag">{award}</span><h3>{event}</h3><p>{project}</p></article>)}</div></div><div class="v2-skills"><h2>Skills &amp; Certifications</h2><p><strong>AI / DATA</strong>Python, SQL, PyTorch, TensorFlow, Pandas, RAG, LangChain, RAGAS</p><p><strong>PRODUCT</strong>TypeScript, React, Java, FastAPI, REST API, Chrome Extension</p><p><strong>CLOUD / TOOLS</strong>AWS, Git, GitHub, Firebase, Selenium, Figma</p><p><strong>CREDENTIALS</strong>{certifications.join(" · ")}</p><p><strong>LANGUAGE</strong>TOEIC 915 · TOEIC Speaking Advanced Low</p></div></div></section>

        <section class="v2-section" id="community"><div class="v2-section-label"><span>06</span><p>COMMUNITY & OPEN SOURCE</p></div><div class="v2-section-body"><ProfileDetails locale="en" /></div></section>

        <footer class="v2-contact"><p>If you have a problem worth solving,</p><h2>Let's build<br /><em>trustworthy AI.</em></h2><div><a href="mailto:flickerlight14@naver.com">flickerlight14@naver.com ↗</a><a href="/en/cv/">View CV ↗</a><a href="#top">Back to top ↑</a></div></footer>
      </div>
    </div>
  </article>
</BaseLayout>
