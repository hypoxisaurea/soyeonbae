---
import ProjectCaseStudy from "../../../components/ProjectCaseStudy.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { projectCasesEn } from "../../../data/projectCasesEn";
import type { ProjectCase } from "../../../data/projectCases";

export function getStaticPaths() {
  return projectCasesEn.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: ProjectCase };
const description = `${project.summary} A case study covering the problem, technology stack, contributions, and lessons learned.`;
---

<BaseLayout locale="en" includeSidebar={false} title={`${project.title} | Soyeon Bae`} description={description} image={null}>
  <ProjectCaseStudy project={project} locale="en" />
</BaseLayout>
