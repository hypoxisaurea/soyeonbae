<script>
  let cleanup: (() => void) | undefined;

  function setupProfile() {
    cleanup?.();
    const profile = document.querySelector<HTMLElement>(".v2-profile");
    if (!profile) return;

    let frame = 0;
    const update = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const fits = window.innerWidth > 900 &&
          profile.getBoundingClientRect().height + 32 <= window.innerHeight;
        profile.classList.toggle("v2-profile--fits", fits);
      });
    };
    const observer = new ResizeObserver(update);
    observer.observe(profile);
    window.addEventListener("resize", update);
    update();

    cleanup = () => {
      observer.disconnect();
      window.removeEventListener("resize", update);
      cancelAnimationFrame(frame);
      profile.classList.remove("v2-profile--fits");
    };
  }

  setupProfile();
  document.addEventListener("astro:page-load", setupProfile);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>
