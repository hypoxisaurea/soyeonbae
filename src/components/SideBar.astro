---
import SideBarMenu from "./SideBarMenu.astro";

const { sideBarActiveItemID } = Astro.props;
---

<div class="drawer-side sidebar-column z-40">
  <label for="my-drawer" class="drawer-overlay" aria-label="Close navigation"></label>

  <aside class="sidebar flex flex-col" aria-label="Sidebar">
    <header class="mb-9">
      <a href="/" class="inline-block no-underline">
        <p class="text-lg font-bold tracking-[0.12em]">BAE SOYEON</p>
        <p class="sidebar-secondary mt-1 text-sm">AI Engineer</p>
      </a>
    </header>

    <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
  </aside>
</div>
