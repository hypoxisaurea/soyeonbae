---
const { locale = "ko" } = Astro.props;
const pathname = Astro.url.pathname;
const koreanPath = locale === "ko" ? pathname : pathname.replace(/^\/en(?=\/|$)/, "") || "/";
const englishPath = locale === "en" ? pathname : pathname === "/" ? "/en/" : `/en${pathname}`;
---

<nav class="language-toggle" aria-label={locale === "ko" ? "언어 선택" : "Language selection"}>
  <a href={koreanPath} lang="ko" hreflang="ko" aria-current={locale === "ko" ? "page" : undefined}>한국어</a>
  <span aria-hidden="true">/</span>
  <a href={englishPath} lang="en" hreflang="en" aria-current={locale === "en" ? "page" : undefined}>English</a>
</nav>
